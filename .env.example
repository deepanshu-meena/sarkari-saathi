# Copy to .env  (Windows: copy .env.example .env). It is loaded automatically; never commit it.
# The Quick form and /api/eligibility need NO model or key. Only the Chat tab does.

# Provider: gemini (default, free tier) | ollama (local) | groq | litellm | bedrock
MODEL_PROVIDER=gemini

# Model id. Empty = provider default (gemini -> gemini/gemini-3.6-flash, tested working).
# Model names get retired: if you see NotFoundError, set MODEL_ID to a current model
# (list yours: https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY).
#   gemini  -> gemini/gemini-3.6-flash        (GEMINI_API_KEY from https://aistudio.google.com)
#   ollama  -> qwen3:8b                       (local; must support tool calling)
#   groq    -> groq/llama-3.3-70b-versatile   (GROQ_API_KEY)
#   litellm -> openrouter/<model>:free        (OPENROUTER_API_KEY)
MODEL_ID=

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_HOST=http://localhost:11434
MODEL_TEMPERATURE=0.2
